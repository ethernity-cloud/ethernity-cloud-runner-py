{
  "description": "The runners' terms of a V2 request (SF21): for each case's settings, the add both runners send (its selector and arguments), the order of the sends, whether the claims path and a score test precede the add, or the refusal before anything is sent with the PoX's revert string (spec/matching.md section 4) or the runner's own message. Both runners replay it; a difference fails the suite of the runner that differs. The quote and the escrow are read on chain (bidQuoteFor, escrowFor) with the add's maxGflops word and are not in this file.",
  "generator": "spec/make/runner-terms.js",
  "source": "abi-selectors.json (addDORequestV2 now and before)",
  "rules": {
    "addForm": "the PoX's VERSION(): \"2.0\" the uint48 maxGflops (EPC minimum in bits 32 to 47), \"1.2\" the uint32 form; the claims path where the pricing's matching() is not zero (OD18 A)",
    "defaults": {
      "maxGflops": 0,
      "relaysPerHour": 0,
      "gasLevel": "1000000000000000000"
    },
    "epc": "max(1, the image's imageEpcUnits, the client's EPC in MiB rounded up to whole 64 MiB units), at most 65,535 (spec/matching.md section 16 item 41; OD23 A)",
    "instances": "one; more under claims is refused by the runner (OD25 A); the V2 add refuses more (\"instance invalid\")",
    "scoreUnits": "a minimum score given as a decimal text, times 10,000, rounded half up on the decimal digits, 0 to 50,000; applied to placements only with claims on (D196)",
    "sends": "the token approval of the escrow, then the add",
    "bounds": {
      "gflopsMax": 6400,
      "maxOrderHours": 168,
      "metadataBytes": 2048,
      "note": "the pricing's gflopsMax and maxOrderHours are the network's; the cases take 6,400 and the rehearsal set's 168 (scripts/lib/pox-2-0-rehearsal.js)"
    }
  },
  "selectors": {
    "addDORequestV2": "0x9f74fcce",
    "addDORequestV2 before": "0x9fdaa26e"
  },
  "cases": [
    {
      "name": "defaults",
      "rule": "no V2 keys given: maxGflops 0 (no ceiling, the need of D38), relaysPerHour 0, gasLevel 1e18 (OD26); the EPC minimum 1 unit (D200)",
      "settings": {
        "claims": true,
        "matching": "set",
        "version": "2.0",
        "bid": "10000000000000000000",
        "hours": 1,
        "cpu": 1,
        "mem": 1,
        "storageGB": 1,
        "bw": 1,
        "instances": 1,
        "metadata1Bytes": 120,
        "metadataBytes": 60
      },
      "expected": {
        "add": {
          "selector": "0x9f74fcce",
          "form": "maxGflops uint48",
          "args": {
            "cpu": 1,
            "mem": 1,
            "storageGB": 1,
            "bw": 1,
            "duration": 1,
            "instances": 1,
            "maxPricePerCuHourWei": "10000000000000000000",
            "maxGflops": "4294967296",
            "relaysPerHour": 0,
            "gasLevel": "1000000000000000000"
          }
        },
        "epcUnits": 1,
        "sends": [
          "token.approve(pox, escrowWei)",
          "addDORequestV2"
        ],
        "claimsPath": true,
        "scoreTestBeforeAdd": false,
        "minScoreUnits": null
      }
    },
